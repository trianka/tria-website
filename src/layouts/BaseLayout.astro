---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Trinity — Design Thinking at the Intersection of Humans & Technology',
  description = 'Trinity works at the intersection of humans and technology in health, education, and poverty alleviation — asking why something needs to exist before asking what to build.',
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalURL} />

    <title>{title}</title>
    <meta name="description" content={description} />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <meta name="theme-color" content="#0b0d10" />

    <noscript>
      <style>
        [data-reveal], [data-reveal-item] { opacity: 1 !important; }
      </style>
    </noscript>
  </head>
  <body>
    <slot />
  </body>
</html>
