---
const email = 'triankam@gmail.com';
---

<section id="contact" class="relative bg-ink px-6 py-28 sm:px-10 sm:py-40">
  <div class="mx-auto max-w-4xl text-center">
    <p data-reveal class="font-sans text-sm uppercase tracking-[0.25em] text-signal">
      Contact
    </p>

    <h2
      data-reveal
      data-reveal-delay="0.08"
      class="text-balance mt-6 font-display text-3xl font-medium leading-tight text-paper sm:text-5xl"
    >
      Working on public systems, health, or education? Let's talk.
    </h2>

    <a
      data-reveal
      data-reveal-delay="0.16"
      href={`mailto:${email}`}
      class="mt-10 inline-block font-display text-2xl text-accent underline decoration-accent/40 decoration-2 underline-offset-8 transition-colors duration-300 hover:text-signal sm:text-3xl"
    >
      {email}
    </a>

    <!-- Add LinkedIn / other links here once shared, e.g.:
    <a href="https://linkedin.com/in/..." class="...">LinkedIn</a>
    -->
  </div>
</section>
